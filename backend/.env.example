# Loaded automatically when the backend starts from this directory.
# Use KEY=value without quotes or export. Escape literal backslashes as \\.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Only required with the additional db profile (local,db or prod,db).
# Copy the pooler host, port and database from Supabase Connect. No real secrets here.
# Use the Supabase pooler in session mode when using JDBC transactions.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/prod-ca-2021.crt
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# DB_POOL_SIZE=5
